# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase Postgres — runtime connection (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Postgres — session-mode connection (port 5432), used only by migrations.
# Session pooler works over IPv4. The true direct host db.<project-ref>.supabase.co is
# IPv6-only unless the IPv4 add-on is enabled, so prefer the pooler form below.
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Postgres TLS. Supabase uses a self-signed chain, keep false unless the CA cert is bundled
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Log every SQL query (noisy, dev only)
DATABASE_LOGGING=false

# Auth. Two independent secrets, min 32 chars each.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<random-48-bytes>
JWT_REFRESH_SECRET=<another-random-48-bytes>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Supabase Storage. Settings -> API: Project URL and the service_role key.
# service_role bypasses RLS — backend only, never ship it to the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Storage -> New bucket, keep "Public bucket" off
SUPABASE_STORAGE_BUCKET=dataroom-files

# Files. 100 MB, PDF only for now; the list is comma separated.
FILE_MAX_SIZE_BYTES=104857600
FILE_ALLOWED_MIME_TYPES=application/pdf
FILE_DOWNLOAD_URL_TTL_SECONDS=900

# Rate limit for /auth/login and /auth/register, per IP
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60
